# Flex TalentVerse - Python Backend Environment Variables
# Copy this file to .env and fill in your values

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=flex_talentverse

# JWT Configuration
JWT_SECRET=flex-talentverse-secret-key-change-in-production-use-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Google OAuth (optional, for SSO)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Email Configuration (Gmail SMTP for College Access Requests)
# To use Gmail SMTP, enable "Less secure app access" or use App Password
# For App Password: Go to Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_support_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SUPPORT_EMAIL=your_support_email@gmail.com
